APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Production: comma-separated exact HTTPS origins, e.g. https://your-app.vercel.app
# FastAPI does not accept https://*.vercel.app wildcards.

# 与 docker-compose.yml 一致：本机端口 5433 → 容器 5432
DATABASE_URL=postgresql+psycopg://retroflow:retroflow@localhost:5433/retroflow

JWT_SECRET=local-dev-secret-change-before-deploy
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Chat：DeepSeek
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding：EMBEDDING_PROVIDER 选后端；BASE_URL / MODEL / KEY 留空则用该 provider 默认
#   ollama       → http://127.0.0.1:11434/v1 + nomic-embed-text（需 ollama pull）
#   openai       → 需 EMBEDDING_API_KEY
#   siliconflow  → 需 EMBEDDING_API_KEY（国内实名）
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
# Must match migration vector(N) and the embedding model (nomic-embed-text = 768)
EMBEDDING_DIM=768

PROBLEM_MATCH_THRESHOLD=0.75

# RAG assistant
RAG_RETRIEVAL_TOP_K=10
RAG_CONTEXT_TOP_K=5
RAG_MIN_SCORE=0.32
RAG_MAX_CITATIONS=5
